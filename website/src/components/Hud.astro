---
// The confirmation the app shows on each flip (HUD.swift), at the app's own size, or with
// `compact`, tightened to sit inside the small screens of a demo without being shrunk.
import Diagram from "./Diagram.astro";
import { LAYOUTS, arrangement, title } from "../scripts/geometry";

interface Props {
  id: string;
  compact?: boolean;
}

const { id, compact = false } = Astro.props;
const layouts = LAYOUTS.map((p) => arrangement(p));
---

<div class:list={["hud", { "hud--compact": compact }]} id={id} aria-hidden="true">
  <Diagram class="diagram--hud" arrangement={layouts[0]} box={{ w: 148, h: 84 }} scaleWith={layouts} />
  <span class="hud-title" data-hud-title>{title(LAYOUTS[0])}</span>
</div>
